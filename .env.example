# Application Configuration
# Copy this file to .env to customize your environment

# Application title displayed in the UI
VITE_APP_TITLE=Timer Lockout

# Application version
VITE_APP_VERSION=1.0.0

# Timer lockout duration in seconds (default: 180 = 3 minutes)
VITE_LOCKOUT_DURATION=180

# Development server port
VITE_PORT=5173
