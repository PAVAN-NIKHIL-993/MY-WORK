# a11y-workbench — environment configuration (all values are public, non-secret)

# Base path for the built app. Use "/" when hosting at a domain root,
# or a sub-path such as "/a11y-workbench/" for GitHub Pages project sites.
VITE_BASE_PATH=/

# Maximum number of findings kept per scan (protects localStorage quota).
# Default in code when unset: 400
VITE_MAX_FINDINGS_PER_SCAN=400

# Maximum accepted markup size in kilobytes for a single capture.
# Default in code when unset: 512
VITE_MAX_CAPTURE_KB=512

# Number of scans retained per project before the oldest are pruned.
# Default in code when unset: 25
VITE_MAX_SCANS_PER_PROJECT=25

# Ship source maps with the production build (default: true).
# Set to "false" to omit them — they publish the full source to every visitor.
VITE_SOURCEMAP=true
